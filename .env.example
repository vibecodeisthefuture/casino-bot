DISCORD_TOKEN=your_token_here
DISCORD_OWNER_IDS=123456789012345678
DISCORD_PREFIX=$
DISCORD_DEFAULT_BET=100
DISCORD_BONUS_MULTIPLIER=5
DISCORD_BONUS_COOLDOWN=12
DISCORD_DAILY_AMOUNT=500
DISCORD_DAILY_COOLDOWN=24
# Optional: set to your server ID for INSTANT slash-command (/) updates — recommended for a single-server bot.
# Leave blank to register slash commands globally (can take up to ~1 hour to appear the first time).
DISCORD_GUILD_ID=
# Role ID that grants access to admin-only commands ($add, market management, etc.).
DISCORD_ADMIN_ROLE_ID=
# Optional: custom server emoji shown next to money amounts. Paste the FULL form,
# e.g. DISCORD_CASH_EMOJI=<:cash:123456789012345678>  (type \:cash: in Discord to reveal the id).
# Leave blank to fall back to a plain "$".
DISCORD_CASH_EMOJI=
# Optional: custom server emoji for Bitcoin, full form e.g. <:bitcoin:123456789012345678>.
# Leave blank to fall back to "BTC".
DISCORD_BITCOIN_EMOJI=
CASINO_DATA_DIR=./data
# Optional overrides:
# CASINO_DATABASE_PATH=./data/economy.db
# CASINO_LOG_PATH=./data/logs/casino-bot.log
